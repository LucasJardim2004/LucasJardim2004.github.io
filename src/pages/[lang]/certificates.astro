---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, t, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<BaseLayout lang={lang} title={t(lang, 'pages.certificates.title')}>
  <h1 class="mb-6 font-serif text-4xl font-medium tracking-tight text-content">
    {t(lang, 'pages.certificates.title')}
  </h1>
  <p class="text-content-secondary">
    {t(lang, 'pages.certificates.placeholder')}
  </p>
</BaseLayout>
