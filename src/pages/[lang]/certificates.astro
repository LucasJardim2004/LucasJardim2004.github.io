---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CertificateCard from '../../components/CertificateCard.astro';
import { getCollection } from 'astro:content';
import { languages, t, isLang, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';

const allCerts = await getCollection('certificates');

// Ordem das categorias na página.
const categoryOrder = ['ai', 'web', 'tools', 'soft-skills'];

// Agrupa por categoria, ordenando cada grupo por data descendente.
const grouped = categoryOrder
  .map((cat) => ({
    key: cat,
    label: t(lang, `pages.certificates.categories.${cat}`),
    items: allCerts
      .filter((c) => c.data.category === cat)
      .sort((a, b) => {
        // date é string "YYYY-MM-DD" nos certificados — comparação lexicográfica
        // funciona correctamente para este formato.
        return b.data.date.localeCompare(a.data.date);
      }),
  }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout
  lang={lang}
  title={`${t(lang, 'pages.certificates.title')} — Lucas Jardim`}
>
  <h1 class="mb-3 font-serif text-4xl font-medium tracking-tight text-content">
    {t(lang, 'pages.certificates.title')}
  </h1>
  <p class="mb-16 text-content-secondary">
    {allCerts.length}
    {lang === 'pt'
      ? allCerts.length === 1 ? 'certificado' : 'certificados'
      : allCerts.length === 1 ? 'certificate' : 'certificates'}
  </p>

  <div class="flex flex-col gap-14">
    {
      grouped.map((group) => (
        <section aria-labelledby={`cat-${group.key}`}>
          <h2
            id={`cat-${group.key}`}
            class="mb-6 font-serif text-xl font-medium text-content"
          >
            {group.label}
          </h2>
          <ul class="grid gap-4 sm:grid-cols-2" role="list">
            {group.items.map((cert) => (
              <li>
                <CertificateCard certificate={cert} lang={lang} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
