---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { languages, t, isLang, type Lang } from '../../../i18n/utils';

export async function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

// isLang garante que o params nunca chega como undefined ao filtro
const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';

const allProjects = await getCollection('projects', ({ id, data }) => {
  return id.startsWith(`${lang}/`) && !data.draft;
});

const projects = allProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout lang={lang} title={`${t(lang, 'pages.projects.title')} — Lucas Jardim`}>
  <h1 class="mb-3 font-serif text-4xl font-medium tracking-tight text-content">
    {t(lang, 'pages.projects.title')}
  </h1>
  <p class="mb-12 text-content-secondary">
    {
      lang === 'pt'
        ? `${projects.length} ${projects.length === 1 ? 'projeto' : 'projetos'}`
        : `${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`
    }
  </p>

  {
    projects.length > 0 ? (
      <ul class="grid gap-8 sm:grid-cols-2" role="list">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} lang={lang} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-content-secondary">
        {t(lang, 'pages.projects.placeholder')}
      </p>
    )
  }
</BaseLayout>
