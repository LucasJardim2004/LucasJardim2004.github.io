---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, t, isLang, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';
---

<BaseLayout lang={lang} title={t(lang, 'pages.contact.title')}>
  <h1 class="mb-6 font-serif text-4xl font-medium tracking-tight text-content">
    {t(lang, 'pages.contact.title')}
  </h1>
  <p class="text-content-secondary">
    {t(lang, 'pages.contact.placeholder')}
  </p>
</BaseLayout>
