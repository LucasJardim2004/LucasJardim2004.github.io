---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, t, isLang, type Lang } from '../../i18n/utils';
import { contact } from '../../config/contact';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';

const links = [
  {
    label: t(lang, 'pages.contact.email'),
    value: contact.email,
    href: `mailto:${contact.email}`,
    icon: 'email',
  },
  {
    label: t(lang, 'pages.contact.phone'),
    value: contact.phone,
    href: `tel:${contact.phone.replace(/\s/g, '')}`,
    icon: 'phone',
  },
  {
    label: t(lang, 'pages.contact.linkedin'),
    value: contact.linkedin.label,
    href: contact.linkedin.url,
    icon: 'linkedin',
    external: true,
  },
  {
    label: t(lang, 'pages.contact.github'),
    value: contact.github.label,
    href: contact.github.url,
    icon: 'github',
    external: true,
  },
];
---

<BaseLayout
  lang={lang}
  title={`${t(lang, 'pages.contact.title')} — Lucas Jardim`}
  description={t(lang, 'pages.contact.intro')}
>
  <h1 class="mb-4 font-serif text-4xl font-medium tracking-tight text-content">
    {t(lang, 'pages.contact.title')}
  </h1>

  <p class="mb-12 max-w-prose text-content-secondary">
    {t(lang, 'pages.contact.intro')}
  </p>

  {/* Links de contacto */}
  <ul class="mb-16 flex flex-col gap-3" role="list">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            {...(link.external
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
            class="group flex items-center gap-4 rounded-card border border-border bg-surface px-5 py-4 transition hover:border-accent"
          >
            {/* Ícone */}
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-control bg-accent-soft text-accent">
              {link.icon === 'email' && (
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M3 4a2 2 0 0 0-2 2v1.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 7.162V6a2 2 0 0 0-2-2H3Z" />
                  <path d="m19 8.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z" />
                </svg>
              )}
              {link.icon === 'phone' && (
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd" />
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {link.icon === 'github' && (
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
              )}
            </span>

            {/* Texto */}
            <div class="min-w-0 flex-1">
              <p class="font-mono text-xs text-content-muted">{link.label}</p>
              <p class="truncate text-sm font-medium text-content transition group-hover:text-accent">
                {link.value}
              </p>
            </div>

            {/* Seta externa */}
            {link.external && (
              <span class="shrink-0 text-content-muted transition group-hover:text-accent" aria-hidden="true">
                ↗
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  {/* CV */}
  <div class="rounded-card border border-border bg-surface p-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="mb-1 font-mono text-xs text-content-muted">Curriculum Vitae</p>
        <p class="font-medium text-content">Lucas Costa Jardim</p>
        <p class="text-sm text-content-secondary">
          {t(lang, 'pages.contact.cvNote')}
        </p>
      </div>
      <a
        href="/cv/lucas-jardim-cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-control bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:bg-accent-hover"
      >
        {t(lang, 'pages.contact.downloadCv')} ↓
      </a>
    </div>
  </div>
</BaseLayout>
