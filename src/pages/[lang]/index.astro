---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroComposition from '../../components/HeroComposition.astro';
import { languages, t, isLang, localizedPath, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';
---

<BaseLayout
  lang={lang}
  title="Lucas Jardim — Tech Analyst & Software Engineer"
  description="Personal site and portfolio of Lucas Jardim, Tech Analyst at Deloitte and BSc in Computer Science and Business Management."
>
  {/* Hero visual — duas colunas em desktop, empilhado em mobile */}
  <section
    class="grid min-h-[70vh] items-center gap-12 py-8 md:grid-cols-[1.1fr,1fr] md:gap-16 md:py-16"
    aria-label="Introduction"
  >
    {/* Coluna esquerda: texto */}
    <div>
      <p class="mb-6 font-mono text-xs uppercase tracking-wider text-accent">
        {t(lang, 'home.role')}
      </p>

      <h1
        class="mb-6 font-serif text-6xl font-medium leading-[0.95] tracking-tight text-content sm:text-7xl md:text-[5.5rem]"
      >
        Lucas<br />Jardim
      </h1>

      <p class="mb-10 max-w-md text-lg leading-relaxed text-content-secondary">
        {t(lang, 'home.intro')}
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href={localizedPath(lang, 'projects')}
          class="rounded-control bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:bg-accent-hover"
        >
          {t(lang, 'home.viewProjects')}
        </a>
        <a
          href={localizedPath(lang, 'contact')}
          class="rounded-control border border-border px-5 py-2.5 text-sm font-medium text-content-secondary transition hover:border-content hover:text-content"
        >
          {t(lang, 'home.getInTouch')}
        </a>
      </div>
    </div>

    {/* Coluna direita: composição visual animada */}
    <div class="flex items-center justify-center">
      <HeroComposition />
    </div>
  </section>
</BaseLayout>
