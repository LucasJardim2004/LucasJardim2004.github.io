---
// Home. Uma rota, dois idiomas: getStaticPaths gera /en/ e /pt/ a partir do
// mesmo molde. Nenhuma lógica se duplica por causa do idioma.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, t, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<BaseLayout lang={lang} title={t(lang, 'home.heading')}>
  <p class="mb-6 font-mono text-sm uppercase tracking-wider text-content-muted">
    {t(lang, 'home.eyebrow')}
  </p>

  <h1
    class="mb-6 font-serif text-5xl font-medium leading-tight tracking-tight text-content sm:text-6xl"
  >
    {t(lang, 'home.heading')}
  </h1>

  <p class="max-w-prose text-lg text-content-secondary">
    {t(lang, 'home.intro')}
  </p>
</BaseLayout>
