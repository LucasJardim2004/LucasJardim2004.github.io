---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { languages, t, isLang, localizedPath, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';

// Projetos em destaque — puxados automaticamente do campo featured: true.
const featuredProjects = (
  await getCollection('projects', ({ id, data }) =>
    id.startsWith(`${lang}/`) && data.featured && !data.draft
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  lang={lang}
  title="Lucas Jardim — Tech Analyst & Software Engineer"
  description="Personal site and portfolio of Lucas Jardim, Tech Analyst at Deloitte and BSc in Computer Science and Business Management."
>
  {/* Hero */}
  <section class="pb-20 pt-4" aria-label="Introduction">
    <p class="mb-4 font-mono text-sm text-accent">
      {t(lang, 'home.role')}
    </p>

    <h1
      class="mb-6 font-serif text-5xl font-medium leading-tight tracking-tight text-content sm:text-6xl"
    >
      {t(lang, 'home.heading')}
    </h1>

    <p class="mb-4 max-w-prose text-lg leading-relaxed text-content-secondary">
      {t(lang, 'home.intro')}
    </p>

    <p class="mb-10 max-w-prose text-base leading-relaxed text-content-muted">
      {t(lang, 'home.interests')}
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href={localizedPath(lang, 'projects')}
        class="rounded-control bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:bg-accent-hover"
      >
        {t(lang, 'home.featuredProjects')}
      </a>
      <a
        href="/cv/lucas-jardim-cv.pdf"
        class="rounded-control border border-border px-5 py-2.5 text-sm font-medium text-content-secondary transition hover:border-content hover:text-content"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t(lang, 'home.downloadCv')}
      </a>
    </div>
  </section>

  {/* Projetos em destaque */}
  {
    featuredProjects.length > 0 && (
      <section aria-labelledby="featured-heading">
        <div class="mb-8 flex items-baseline justify-between gap-4">
          <h2
            id="featured-heading"
            class="font-serif text-2xl font-medium text-content"
          >
            {t(lang, 'home.featuredProjects')}
          </h2>
          <a
            href={localizedPath(lang, 'projects')}
            class="text-sm text-accent transition hover:text-accent-hover"
          >
            {t(lang, 'home.allProjects')} →
          </a>
        </div>

        <ul class="grid gap-8 sm:grid-cols-2" role="list">
          {featuredProjects.map((project) => (
            <li>
              <ProjectCard project={project} lang={lang} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
