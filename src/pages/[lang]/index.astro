---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, t, isLang, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';
---

<BaseLayout lang={lang} title={t(lang, 'home.heading')}>
  <p class="mb-6 font-mono text-sm uppercase tracking-wider text-content-muted">
    {t(lang, 'home.eyebrow')}
  </p>

  <h1 class="mb-6 font-serif text-5xl font-medium leading-tight tracking-tight text-content sm:text-6xl">
    {t(lang, 'home.heading')}
  </h1>

  <p class="max-w-prose text-lg text-content-secondary">
    {t(lang, 'home.intro')}
  </p>
</BaseLayout>
