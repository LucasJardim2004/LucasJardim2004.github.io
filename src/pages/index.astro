---
// A raiz encaminha para o idioma por omissão (inglês). Como o site é 100%
// estático, o redirect é feito no cliente (meta refresh + JS de fallback).
// Nenhuma página fica órfã sem prefixo de idioma.
import { defaultLang } from '../i18n/utils';

const target = `/${defaultLang}/`;
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <title>Lucas Jardim</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={target}>{target}</a>…
    </p>
  </body>
</html>
