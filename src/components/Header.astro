---
// Header do site: nome à esquerda (link para home), navegação ao centro,
// controlos à direita. Consistente em todas as páginas. Marca a secção atual
// via aria-current, e o CV destaca-se ligeiramente como ação primária.
import { t, localizedPath, type Lang } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const currentPath = Astro.url.pathname;

// Determina se um item de navegação é o atual (para aria-current + estilo).
const isCurrent = (path: string): boolean => {
  const target = localizedPath(lang, path);
  return currentPath === target || currentPath === `${target}/`;
};

const navItems = [
  { key: 'projects', label: t(lang, 'nav.projects'), href: localizedPath(lang, 'projects') },
  { key: 'certificates', label: t(lang, 'nav.certificates'), href: localizedPath(lang, 'certificates') },
  { key: 'contact', label: t(lang, 'nav.contact'), href: localizedPath(lang, 'contact') },
];
---

<header
  class="border-b border-border"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-5">
    {/* Nome / logo: link para a home do idioma atual */}
    <a
      href={localizedPath(lang)}
      class="font-serif text-lg font-medium tracking-tight text-content transition hover:text-accent"
    >
      Lucas Jardim
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      {/* Navegação principal */}
      <nav aria-label="Primary" class="hidden sm:block">
        <ul class="flex items-center gap-4 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.key) ? 'page' : undefined}
                  class:list={[
                    'transition hover:text-content',
                    isCurrent(item.key)
                      ? 'text-content'
                      : 'text-content-secondary',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* CV: ação primária, destaca-se ligeiramente */}
      <a
        href="/cv/lucas-jardim-cv.pdf"
        class="hidden rounded-control border border-accent px-3 py-1.5 text-sm text-accent transition hover:bg-accent-soft md:inline-block"
      >
        {t(lang, 'nav.downloadCv')}
      </a>

      <LanguageSwitcher lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
  </div>

  {/* Navegação para telemóvel (aparece por baixo do header) */}
  <nav aria-label="Primary mobile" class="border-t border-border sm:hidden">
    <ul class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-3 text-sm">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.key) ? 'page' : undefined}
              class:list={[
                'transition hover:text-content',
                isCurrent(item.key)
                  ? 'text-content'
                  : 'text-content-secondary',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/cv/lucas-jardim-cv.pdf"
          class="text-accent transition hover:text-accent-hover"
        >
          {t(lang, 'nav.downloadCv')}
        </a>
      </li>
    </ul>
  </nav>
</header>
