---
import { t, type Lang } from '../i18n/utils';
import { contact } from '../config/contact';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
  <div
    class="mx-auto flex max-w-3xl flex-col items-start justify-between gap-4 px-6 py-8 text-sm text-content-secondary sm:flex-row sm:items-center"
  >
    <p>© {year} Lucas Jardim</p>

    <div class="flex items-center gap-4">
      <a
        href={contact.github.url}
        class="transition hover:text-content"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        GitHub
      </a>
      <a
        href={contact.linkedin.url}
        class="transition hover:text-content"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        LinkedIn
      </a>
      <a
        href="https://github.com/LucasJardim2004/LucasJardim2004.github.io"
        class="transition hover:text-content"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t(lang, 'footer.viewSource')}
      </a>
    </div>
  </div>
</footer>
