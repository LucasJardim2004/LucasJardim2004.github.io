---
// Card de certificado. Mostra a imagem do certificado quando existe,
// caso contrário mostra um bloco com as iniciais do emissor.
import { Image } from 'astro:assets';
import { type Lang, t } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  certificate: CollectionEntry<'certificates'>;
  lang: Lang;
}

const { certificate, lang } = Astro.props;
const { title, issuer, date, credentialUrl, image } = certificate.data;

const year = new Date(date).getFullYear();

// Iniciais do emissor para o fallback visual
const initials = issuer
  .split(' ')
  .filter((w: string) => w.length > 2)
  .slice(0, 2)
  .map((w: string) => w[0])
  .join('');
---

<article
  class="flex flex-col overflow-hidden rounded-card border border-border bg-surface transition duration-150 hover:border-content-secondary"
>
  {/* Imagem do certificado */}
  {
    image ? (
      <div class="aspect-[4/3] w-full overflow-hidden bg-accent-soft">
        <Image
          src={image}
          alt={`${title} — ${issuer}`}
          width={600}
          height={450}
          class="h-full w-full object-cover object-top"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="flex aspect-[4/3] w-full items-center justify-center bg-accent-soft">
        <span class="font-serif text-4xl font-medium text-accent opacity-40">
          {initials}
        </span>
      </div>
    )
  }

  {/* Conteúdo */}
  <div class="flex flex-1 items-start justify-between gap-4 p-4">
    <div class="flex-1 min-w-0">
      <p class="mb-1 font-mono text-xs text-content-muted">{issuer} · {year}</p>
      <h3 class="font-medium leading-snug text-content text-sm">{title}</h3>
    </div>

    {/* Ícone de credencial verificada */}
    {
      credentialUrl && (
        <a
          href={credentialUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${t(lang, 'pages.certificates.verify')} — ${title}`}
          class="mt-0.5 shrink-0 text-accent transition hover:text-accent-hover"
          title={t(lang, 'pages.certificates.verify')}
        >
          <svg
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>
