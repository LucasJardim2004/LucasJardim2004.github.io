---
// Card de certificado. Mais enxuto que o ProjectCard — sem imagem de capa,
// sem corpo longo. Título, emissor, data, e link de verificação opcional.
import { type Lang, t } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  certificate: CollectionEntry<'certificates'>;
  lang: Lang;
}

const { certificate, lang } = Astro.props;
const { title, issuer, date, credentialUrl } = certificate.data;

const year = new Date(date).getFullYear();
---

<article
  class="flex flex-col gap-3 rounded-card border border-border bg-surface p-5 transition duration-150 hover:border-content-secondary"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1">
      <p class="mb-1 font-mono text-xs text-content-muted">{issuer} · {year}</p>
      <h3 class="font-medium leading-snug text-content">{title}</h3>
    </div>

    {/* Ícone de credencial verificada, quando existe */}
    {
      credentialUrl && (
        <a
          href={credentialUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${t(lang, 'pages.certificates.verify')} — ${title}`}
          class="mt-0.5 shrink-0 text-accent transition hover:text-accent-hover"
          title={t(lang, 'pages.certificates.verify')}
        >
          <svg
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>
